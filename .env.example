# This file contains examples only. Do not put real secrets in version control.
# Prefer OS environment variables or the system keyring via scripts/set_secret.py.

CIVIC_METRICS_DATABASE_URL=sqlite+pysqlite:///./data/civic_metrics.db
CIVIC_METRICS_LOG_LEVEL=INFO
CIVIC_METRICS_HTTP_TIMEOUT_SECONDS=45
CIVIC_METRICS_MAX_HISTORY_PERIODS=12
CIVIC_METRICS_FAIL_FAST=false

# Optional LLM-based semantic validation. OPENAI_API_KEY is read by the OpenAI SDK.
CIVIC_METRICS_GENAI_VALIDATION_ENABLED=false
CIVIC_METRICS_GENAI_VALIDATION_MODEL=gpt-4o-mini
CIVIC_METRICS_GENAI_VALIDATION_MAX_PAYLOAD_CHARS=60000
CIVIC_METRICS_GENAI_VALIDATION_STRICT=false
# OPENAI_API_KEY=

# Optional alternative to the system keyring. Environment variables are read at runtime.
# CIVIC_METRICS_DATACOMEX_USERNAME=
# CIVIC_METRICS_DATACOMEX_PASSWORD=
