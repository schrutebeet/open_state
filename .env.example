# This file contains examples only. Do not put real secrets in version control.
# Prefer OS environment variables or the system keyring via scripts/set_secret.py.

DATABASE_URL=sqlite+pysqlite:///./data/civic_metrics.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=45
MAX_HISTORY_PERIODS=12
FAIL_FAST=false

# Optional LLM-based semantic validation.
GENAI_VALIDATION_ENABLED=false
GENAI_VALIDATION_MODEL=gpt-5.6-luna
GENAI_VALIDATION_MAX_PAYLOAD_CHARS=100000
GENAI_VALIDATION_STRICT=false
# OPENAI_API_KEY=ABCDEFG

# Optional alternative to the system keyring. Environment variables are read at runtime.
# DATACOMEX_USERNAME=
# DATACOMEX_PASSWORD=
